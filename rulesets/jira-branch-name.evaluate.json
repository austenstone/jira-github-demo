{
  "name": "Jira branch naming",
  "target": "branch",
  "enforcement": "evaluate",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/main"
      ]
    }
  },
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "ABC-123-description",
        "negate": false,
        "operator": "regex",
        "pattern": "^[A-Z][A-Z0-9_]{1,9}-[1-9][0-9]*-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  ]
}
